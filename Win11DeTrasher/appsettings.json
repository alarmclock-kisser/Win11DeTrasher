{
  "ConfigurationVersion": 2,
  "LoggerSettings": {
    "MaxLogEntries": 20000,
    "UseRingBuffer": null,
    "LogDirectory": "%LOCALAPPDATA%\\Win11DeTrasher\\Logs",
    "CreateLogFile": true,
    "MaxLogFiles": 16,
    "MaxRepositoryLogFiles": 8,
    "Silent": false,
    "LogTimestampFormat": "HH:mm:ss.fff",
    "FileTimestampFormat": "yyyy-MM-dd_HH-mm-ss",
    "LogFileBaseName": "Win11DeTrasher_",
    "LogFileExtension": ".txt",
    "FilterPhrase": null,
    "EchoToConsole": false,
    "EchoToConsoleKeyPhrases": [
      "[SUCCESS]",
      "[ERROR]",
      "[WARN",
      "Exception:"
    ],
    "SaveToRepository": false,
    "SaveToRepositoryCustomFilePath": null,
    "ExceptionPrintSettings": {
      "InnerExceptionMaxDepth": null,
      "InnerExceptionAppendStackTrace": true,
      "InnerExceptionAsSingleLine": false,
      "InnerExceptionOpeningBracket": "(",
      "InnerExceptionClosingBracket": ")",
      "InnerExceptionSeparator": " "
    }
  }
}
